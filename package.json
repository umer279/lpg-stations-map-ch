{
  "name": "gpl-map",
  "version": "1.0.0",
  "private": true,
  "description": "Map of LPG (GPL/autogas) stations in Switzerland",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch src/server.ts\" \"npm:web:watch\"",
    "web:build": "esbuild public/app.ts --bundle --format=iife --target=es2020 --outfile=public/app.js",
    "web:watch": "npm run web:build -- --watch=forever",
    "build": "tsc -p tsconfig.json && npm run web:build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p public/tsconfig.json && tsc -p api/tsconfig.json",
    "start": "node dist/server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^26.6.4",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
